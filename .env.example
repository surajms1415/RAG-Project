# Application Settings
APP_NAME="Enterprise AI Document & Analytics Platform"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
LOG_JSON=False

# Database Connection (PostgreSQL or SQLite fallback for local testing)
# PostgreSQL default: postgresql+psycopg://postgres:postgres@localhost:5432/rag_db
DATABASE_URL=sqlite:///./dev_platform.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=5
AUTO_APPLY_MIGRATIONS=True

# File Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_INGESTION_RETRIES=3

# LLM & Embedding Secrets
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
